# App
PORT=3000

# Postgres (only used if you spin up docker-compose.yml for local dev instead of Neon)
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance_backend
POSTGRES_PORT=5432

# Prisma / Neon
# DATABASE_URL uses the pooled connection (runtime queries via pgbouncer).
# DIRECT_URL uses the direct connection (required by Prisma Migrate).
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require"

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRATION=7d
