# Copy this file to `.env.production` on the VPS and fill in real values.
# Never commit `.env.production` itself.

NODE_ENV=production
PORT=3000

# Postgres (consumed by the `postgres` service in docker-compose.prod.yml)
POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=finance_backend

# Self-hosted Postgres has no separate pooler like Neon did, so both URLs
# point directly at the `postgres` service (its Docker Compose service name
# doubles as its hostname on the `internal` network).
DATABASE_URL=postgresql://finance:change-me-strong-password@postgres:5432/finance_backend
DIRECT_URL=postgresql://finance:change-me-strong-password@postgres:5432/finance_backend

# Generate real secrets with: openssl rand -base64 32
JWT_ACCESS_SECRET=change-me-generate-a-real-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change-me-generate-a-real-secret
JWT_REFRESH_EXPIRATION=7d

# Comma-separated list of allowed frontend origins. Required in production —
# without it, cross-origin requests are blocked (see src/main.ts).
CORS_ORIGIN=https://luishuarachi.tech,https://www.luishuarachi.tech
