// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String   @id @default(uuid())
  username          String   @unique
  firstName         String
  lastName          String
  email             String   @unique
  phoneNumber       String
  password          String
  refreshToken      String?
  preferredCurrency String   @default("PEN")
  timezone          String   @default("UTC")
  language          String   @default("es")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  accounts              Account[]
  categories            Category[]
  transactions          Transaction[]
  budgets               Budget[]
  statements            Statement[]
  reconciliationMatches ReconciliationMatch[]
  recurringExpenses     RecurringExpense[]
  savingsTarget         SavingsTarget?
  financialGoals        FinancialGoal[]
}

enum AccountType {
  BANK_ACCOUNT
  CASH
  DIGITAL_WALLET
}

enum AccountStatus {
  ACTIVE
  ARCHIVED
}

model Account {
  id             String        @id @default(uuid())
  userId         String
  name           String
  institution    String?
  accountType    AccountType
  currency       String
  initialBalance Decimal       @db.Decimal(14, 2)
  currentBalance Decimal       @db.Decimal(14, 2)
  status         AccountStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])

  transactionsAsSource      Transaction[] @relation("SourceAccountTransactions")
  transactionsAsDestination Transaction[] @relation("DestinationAccountTransactions")
  statements                Statement[]
  recurringExpenses         RecurringExpense[]

  @@index([userId])
}

enum CategoryType {
  EXPENSE
  INCOME
}

model Category {
  id          String       @id @default(uuid())
  userId      String
  name        String
  type        CategoryType
  description String?
  color       String?
  icon        String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id])

  transactions      Transaction[]
  budgets           Budget[]
  recurringExpenses RecurringExpense[]

  @@unique([userId, name, type])
  @@index([userId])
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
}

enum TransactionStatus {
  ACTIVE
  ARCHIVED
}

model Transaction {
  id                 String            @id @default(uuid())
  userId             String
  accountId          String
  toAccountId        String?
  categoryId         String?
  recurringExpenseId String?
  type               TransactionType
  amount             Decimal           @db.Decimal(14, 2)
  currency           String
  transactionDate    DateTime
  notes              String?
  status             TransactionStatus @default(ACTIVE)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user             User              @relation(fields: [userId], references: [id])
  account          Account           @relation("SourceAccountTransactions", fields: [accountId], references: [id])
  toAccount        Account?          @relation("DestinationAccountTransactions", fields: [toAccountId], references: [id])
  category         Category?         @relation(fields: [categoryId], references: [id])
  recurringExpense RecurringExpense? @relation(fields: [recurringExpenseId], references: [id])

  reconciliationMatches ReconciliationMatch[]

  @@index([userId])
  @@index([accountId])
  @@index([toAccountId])
  @@index([categoryId])
  @@index([recurringExpenseId])
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
}

model Budget {
  id         String       @id @default(uuid())
  userId     String
  categoryId String
  name       String
  amount     Decimal      @db.Decimal(14, 2)
  currency   String
  period     BudgetPeriod
  startDate  DateTime
  endDate    DateTime
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@index([categoryId])
}

enum ImportProvider {
  YAPE
}

enum ImportFileFormat {
  CSV
  XLSX
}

enum ImportStatus {
  PENDING
  PROCESSED
  FAILED
}

enum ImportReconciliationStatus {
  UNRECONCILED
  RECONCILED
}

model Statement {
  id               String           @id @default(uuid())
  userId           String
  accountId        String
  provider         ImportProvider
  fileFormat       ImportFileFormat
  fileName         String
  fileHash         String
  status           ImportStatus     @default(PENDING)
  transactionCount Int              @default(0)
  errorMessage     String?
  importedAt       DateTime         @default(now())

  user                 User                  @relation(fields: [userId], references: [id])
  account              Account               @relation(fields: [accountId], references: [id])
  importedTransactions ImportedTransaction[]

  @@unique([userId, accountId, fileHash])
  @@index([userId])
  @@index([accountId])
}

model ImportedTransaction {
  id                   String                     @id @default(uuid())
  statementId          String
  externalId           String?
  transactionDate      DateTime
  description          String
  amount               Decimal                    @db.Decimal(14, 2)
  currency             String
  reference            String?
  rawData              Json
  reconciliationStatus ImportReconciliationStatus @default(UNRECONCILED)
  createdAt            DateTime                   @default(now())

  statement Statement @relation(fields: [statementId], references: [id])

  reconciliationMatches ReconciliationMatch[]

  @@index([statementId])
}

enum ReconciliationStatus {
  MATCHED
  UNMATCHED
  IGNORED
}

model ReconciliationMatch {
  id                    String               @id @default(uuid())
  userId                String
  transactionId         String?
  importedTransactionId String
  matchScore            Float?
  status                ReconciliationStatus
  reviewedAt            DateTime
  createdAt             DateTime             @default(now())

  user                User                @relation(fields: [userId], references: [id])
  transaction         Transaction?        @relation(fields: [transactionId], references: [id])
  importedTransaction ImportedTransaction @relation(fields: [importedTransactionId], references: [id])

  @@index([userId])
  @@index([transactionId])
  @@index([importedTransactionId])
}

enum RecurringExpenseFrequency {
  WEEKLY
  MONTHLY
}

model RecurringExpense {
  id         String                    @id @default(uuid())
  userId     String
  categoryId String
  accountId  String
  name       String
  amount     Decimal                   @db.Decimal(14, 2)
  currency   String
  frequency  RecurringExpenseFrequency
  dayOfMonth Int?
  dayOfWeek  Int?
  startDate  DateTime
  endDate    DateTime?
  active     Boolean                   @default(true)
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt

  user     User          @relation(fields: [userId], references: [id])
  category Category      @relation(fields: [categoryId], references: [id])
  account  Account       @relation(fields: [accountId], references: [id])
  payments Transaction[]

  @@index([userId])
  @@index([categoryId])
  @@index([accountId])
}

model SavingsTarget {
  id         String   @id @default(uuid())
  userId     String   @unique
  percentage Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

enum FinancialGoalStatus {
  ACTIVE
  ACHIEVED
  ARCHIVED
}

model FinancialGoal {
  id                 String              @id @default(uuid())
  userId             String
  name               String
  targetAmount       Decimal             @db.Decimal(14, 2)
  currency           String
  currentSavedAmount Decimal             @default(0) @db.Decimal(14, 2)
  targetDate         DateTime?
  priority           Int?
  status             FinancialGoalStatus @default(ACTIVE)
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}
