// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String   @id @default(uuid())
  username          String   @unique
  firstName         String
  lastName          String
  email             String   @unique
  phoneNumber       String
  password          String
  refreshToken      String?
  preferredCurrency String   @default("PEN")
  timezone          String   @default("UTC")
  language          String   @default("es")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  accounts   Account[]
  categories Category[]
}

enum AccountType {
  BANK_ACCOUNT
  CASH
  DIGITAL_WALLET
}

enum AccountStatus {
  ACTIVE
  ARCHIVED
}

model Account {
  id             String        @id @default(uuid())
  userId         String
  name           String
  institution    String?
  accountType    AccountType
  currency       String
  initialBalance Decimal       @db.Decimal(14, 2)
  status         AccountStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum CategoryType {
  EXPENSE
  INCOME
}

model Category {
  id          String       @id @default(uuid())
  userId      String
  name        String
  type        CategoryType
  description String?
  color       String?
  icon        String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, name, type])
  @@index([userId])
}
